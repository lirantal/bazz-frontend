{
  "name": "bazz-frontend",
  "version": "0.1.0",
  "dependencies": {
    "react": "^16.1.1",
    "react-dom": "^16.1.1",
    "react-scripts": "4.0.0",
    "semantic-ui-css": "^2.2.12",
    "semantic-ui-react": "^0.77.0"
  },
  "scripts": {
    "//start": "react-scripts build && cra-append-sw --skip-compile --mode dev ./custom-sw.js",
    "build": "react-scripts build && cra-append-sw --skip-compile ./custom-sw.js",
    "start": "react-scripts start",
    "test": "react-scripts test --env=jsdom",
    "eject": "react-scripts eject",
    "lint": "echo \"No lint step configured\"",
    "lint:markdown": "markdownlint -c .github/.markdownlint.yml '**/**.md'",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "proxy": "http://localhost:3000",
  "devDependencies": {
    "cra-append-sw": "^2.0.0",
    "enzyme": "^3.3.0",
    "enzyme-adapter-react-16": "^1.1.1",
    "react-test-renderer": "^16.2.0",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "markdownlint-cli": "0.45.0"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.10.0"
  }
}
